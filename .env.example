# Public origin of the site (no trailing slash). Used for canonical URLs,
# Open Graph images, robots.txt and the sitemap. Leave unset on Vercel unless
# you have a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side endpoint that verifies merchant credentials.
# Leave empty until the I&M merchant authentication API is available —
# any form-valid Merchant ID and password then opens a preview session.
MERCHANT_AUTH_API_URL=

# Server-side endpoint for merchant reporting data (dashboard, transactions,
# account). Requests carry the session token; the backend must scope every
# response to the authenticated merchant.
MERCHANT_API_URL=
